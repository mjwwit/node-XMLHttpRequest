{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"ignorePatterns": ["dist/**"],
	"useTabs": true,
	"tabWidth": 2,
	"semi": false,
	"singleQuote": true,
	"printWidth": 100,
	"arrowParens": "always",
	"trailingComma": "all",
	"insertFinalNewline": true,
	"endOfLine": "lf",
	"sortImports": {
		"type": "natural",
		"newlinesBetween": false,
		"groups": ["builtin", "external", "internal", "parent", "sibling", "index", "unknown"]
	}
}
